<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Archive · quiet ai</title>
<meta name="description" content="Every past morning edition of quiet ai.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23f6f3ec'/%3E%3Cpath d='M8 20h16M8 14h11' stroke='%23302d28' stroke-width='2.4' stroke-linecap='round'/%3E%3C/svg%3E">
<link rel="stylesheet" href="{{ root }}static/style.css">
</head>
<body>
<div class="page about">
<header class="masthead">
  <div class="masthead-top">
    <p class="wordmark"><a href="{{ root }}">quiet ai</a></p>
    <p class="dateline"><a href="{{ root }}">Today's overview</a><span class="sep">·</span><span aria-current="page">Archive</span><span class="sep">·</span><a href="{{ root }}about/">About</a></p>
  </div>
</header>
<main class="prose">
<h1>Archive</h1>
<p class="lede">Every morning's edition, as it was published.</p>
{% if days %}
<ol class="archive-list">
  {% for d in days %}
  <li>
    <p class="a-date"><a href="{{ d.date }}/">{{ d.long }}</a></p>
    {% if d.weather %}<p class="a-weather">{{ d.weather }}</p>{% endif %}
    {% if d.headlines %}<ul class="a-heads">{% for h in d.headlines %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
  </li>
  {% endfor %}
</ol>
{% else %}
<p>Editions appear here the morning after they are published.</p>
{% endif %}
</main>
</div>
</body>
</html>
