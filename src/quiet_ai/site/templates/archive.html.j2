<!doctype html>
{% import "_brand.html.j2" as brand %}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Archive · Qaiet Times</title>
<meta name="description" content="Every past morning edition of Qaiet Times.">
{{ brand.favicon() }}
{{ brand.theme_boot() }}
<link rel="stylesheet" href="{{ root }}static/style.css">
</head>
<body>
<div class="page about">
<header class="masthead">
  <div class="masthead-top">
    {{ brand.wordmark(root) }}
    {{ brand.nav(root, "archive") }}
  </div>
  <hr class="rule">
</header>
<main class="prose wide">
<h1>Archive</h1>
<p class="lede">Every morning's edition, as it was published.</p>
{% if days %}
<ol class="archive-list">
  {% for d in days %}
  <li>
    <p class="a-date"><a href="{{ d.date }}/">{{ d.long }}</a></p>
    {% if d.weather %}<p class="a-weather">{{ d.weather }}</p>{% endif %}
    {% if d.headlines %}<ul class="a-heads">{% for h in d.headlines %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
  </li>
  {% endfor %}
</ol>
{% else %}
<p>Editions appear here the morning after they are published.</p>
{% endif %}
</main>
</div>
<script src="{{ root }}static/app.js" defer></script>
</body>
</html>
