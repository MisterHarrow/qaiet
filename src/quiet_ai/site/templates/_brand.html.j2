{# The brand pieces every page shares: favicon, wordmark, site navigation and the light/dark switch.
   The mark is the stance scale as five bars, umber (critical) to sage (positive). #}

{% macro favicon() -%}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232a2826'/%3E%3Crect x='3.5' y='15' width='3.8' height='10' fill='%23d1956a'/%3E%3Crect x='8.8' y='11' width='3.8' height='14' fill='%23b38c6d'/%3E%3Crect x='14.1' y='7' width='3.8' height='18' fill='%238f8880'/%3E%3Crect x='19.4' y='12' width='3.8' height='13' fill='%2393ac95'/%3E%3Crect x='24.7' y='17' width='3.8' height='8' fill='%23a3c9a6'/%3E%3C/svg%3E">
{%- endmacro %}

{# Before the stylesheet paints: apply a saved dark choice so dark pages don't flash light, and mark the first
   page of a visit (sessionStorage) so the greeting plays once. Light is the default; nothing else is stored. #}
{% macro theme_boot() -%}
<script>try{var d=document.documentElement;if(localStorage.getItem("theme")==="dark")d.setAttribute("data-theme","dark");if(!sessionStorage.getItem("greeted")&&!matchMedia("(prefers-reduced-motion: reduce)").matches)d.classList.add("greet")}catch(e){}</script>
{%- endmacro %}

{% macro wordmark(href) -%}
<p class="wordmark"><a href="{{ href }}"><svg class="mark" viewBox="0 0 25 18" aria-hidden="true" focusable="false"><rect class="m1" x="0" y="8" width="3.8" height="10"/><rect class="m2" x="5.3" y="4" width="3.8" height="14"/><rect class="m3" x="10.6" y="0" width="3.8" height="18"/><rect class="m4" x="15.9" y="5" width="3.8" height="13"/><rect class="m5" x="21.2" y="10" width="3.8" height="8"/></svg><span class="wm">Qaiet Times</span></a></p>
{%- endmacro %}

{% macro nav(root, current) -%}
<nav class="sitenav" aria-label="Site">
  {%- for key, href, label in [("today", root or "./", "Today"), ("narratives", root ~ "narratives/", "Narratives"), ("index", root ~ "sentiment/", "Index"), ("archive", root ~ "archive/", "Archive"), ("about", root ~ "about/", "About")] %}
  <a href="{{ href }}"{% if key == current %} aria-current="page"{% endif %}>{{ label }}</a>
  {%- endfor %}
  <button type="button" class="theme-toggle" aria-pressed="false" hidden><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg>Dark</button>
</nav>
{%- endmacro %}
