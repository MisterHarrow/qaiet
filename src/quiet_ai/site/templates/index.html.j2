<!doctype html>
{% import "_brand.html.j2" as brand %}
{% import "_narratives.html.j2" as nar %}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Qaiet Times · {% if desk_label %}{{ desk_label }} · {% endif %}{% if frozen_date %}{{ frozen_date }}{% else %}{{ period.label }} · {{ date_long }}{% endif %}</title>
<meta name="description" content="Qaiet Times, a quiet daily overview{% if desk_label %} of {{ desk_label|lower }}: what happened and how it is framed{% else %} of AI: what happened, how it is framed, and what builders are making{% endif %}.">
{{ brand.favicon() }}
{{ brand.theme_boot() }}
<link rel="stylesheet" href="{{ root }}static/style.css">
</head>
<body>
{{ seal_defs }}
<div class="page">

<header class="masthead">
  <div class="masthead-top">
    {{ brand.wordmark(root or './') }}
    {{ brand.nav(root, "archive" if frozen_date else "today", base) }}
  </div>
  {% if desks %}{{ brand.desks(desks) }}{% endif %}
  {% if mix_segments %}
  <p class="spectrum" role="img" aria-label="{{ mix_label }}" title="{{ mix_label }}">{% for seg in mix_segments %}<span class="seg st{{ seg.key }}" style="width:{{ seg.pct }}%"></span>{% endfor %}</p>
  {% else %}
  <hr class="rule">
  {% endif %}
  <div class="masthead-body">
  <div class="mb-main">
  {% set sv = (e.sentiment or {}).get("values") or {} %}
  {% if sv.get("all") is not none %}
  {# The greeting: the day's sentiment under the nameplate. On the first page of a visit the figure counts up
     from zero and the line steps in (app.js and .greet); otherwise, and without JS, it simply shows. #}
  <div class="sentiment">
    <p class="sent-line"><a class="sent-label step" href="{{ base }}sentiment/">The sentiment</a>
      <span class="sent-num step" data-value="{{ sv['all'] }}">{{ sv["all"]|signed }}</span>
      <span class="sent-word step">{{ e.sentiment.words }}{% if e.sentiment.days > 1 %} <span class="sent-note">{{ e.sentiment.days }}-day average</span>{% endif %}</span>
      <span class="sent-track step">Technical <b data-track="technical">{{ sv.get("technical")|signed }}</b></span><span class="sent-track step">Political <b data-track="political">{{ sv.get("political")|signed }}</b></span><span class="sent-track step">Economic <b data-track="economic">{{ sv.get("economic")|signed }}</b></span></p>
    {% if e.sentiment.places %}
    {# The same index per region and per country: picking a place in the story filter shows its figures (app.js). #}
    <script type="application/json" id="sent-places">{{ {"days": e.sentiment.days, "min_outlets": e.sentiment.min_outlets, "places": e.sentiment.places}|tojson }}</script>
    {% endif %}
  </div>
  {% endif %}
  <div class="masthead-meta">
    {% if periods|length > 1 %}
    <nav class="periods" aria-label="Time period">
      <span class="periods-label">Last</span>
      {% for p in periods %}<a href="{{ p.href or './' }}"{% if p.active %} aria-current="page"{% endif %}>{{ p.label }}</a>{% endfor %}
    </nav>
    {% endif %}
    <p class="dateline">{% if frozen_date %}Edition of {{ frozen_date }}{% else %}<time datetime="{{ e.generated_at }}">{{ date_long }}</time> <span class="sep">·</span> updated {{ updated }} {{ tz_name }}{% endif %}</p>
  </div>
  </div>
  {% if geo %}
  {# Where the coverage comes from: outlets per region (one square per country), each region's sentiment in this view,
     and a dot map that lights up where they are. Hover or focus for the counts. #}
  {% set geo_label %}{{ geo.outlets }} outlet{{ "s" if geo.outlets != 1 }} in {{ geo.countries|length }} countr{{ "ies" if geo.countries|length != 1 else "y" }}: {% for c, n in geo.countries %}{{ country_names.get(c, c) }} {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}{% endset %}
  <div class="geo-box">
  <p class="geo-head">Outlets and sentiment by region</p>
  <div class="geo" tabindex="0" role="img" aria-label="Where the coverage in this view comes from. {{ geo_label }}." style="--legend-h: {{ geo.legend_h }}">
    <ul class="geo-legend" aria-hidden="true">
      {% for r in geo.regions %}{% set v = (((e.sentiment or {}).get("places") or {}).get(r.name) or {}).get("values", {}).get("all") %}<li{% if not r.n %} class="geo-none"{% endif %}><span class="geo-region">{{ r.name }}</span><span class="geo-sqs">{% for c in r.countries %}<i class="geo-sq{% if c.n > 3 %} n3{% elif c.n > 1 %} n2{% elif c.n %} n1{% endif %}" title="{{ c.name }}: {{ c.n }} outlet{{ "s" if c.n != 1 }}"></i>{% endfor %}</span><b class="geo-sent{% if v is not none and v <= -0.15 %} crit{% elif v is not none and v >= 0.15 %} pos{% endif %}">{{ v|signed }}</b></li>{% endfor %}
    </ul>
    {{ geo.svg }}
    <span class="geo-tip" aria-hidden="true"><span class="tip-head">{{ geo.outlets }} outlet{{ "s" if geo.outlets != 1 }} · {{ geo.countries|length }} countr{{ "ies" if geo.countries|length != 1 else "y" }}</span>{% for c, n in geo.countries %}<span class="tip-row">{{ country_names.get(c, c) }}<b>{{ n }}</b></span>{% endfor %}</span>
  </div>
  </div>
  {% endif %}
  {# The day's line runs across the page under both. #}
  <div class="mb-lead">
  {% if frozen_date %}
  <p class="partial">The edition published on {{ frozen_date }} at {{ updated }} {{ tz_name }}. It no longer changes. <a href="{{ base or './' }}">Today's overview</a></p>
  {% endif %}
  {% if data_since and not frozen_date %}
  <p class="partial">Collecting since {{ data_since }}, so this view covers less than {{ period.label }} so far. It fills in as the days pass.</p>
  {% endif %}
  {% if e.weather %}
  <p class="weather">{{ e.weather }}</p>
  {% endif %}
  {% if e.energy_data %}
  {# Figures beside the news (pipeline/energy_data.py): never labeled, never in the index. Ink only, no stance colors. #}
  {% set ed = e.energy_data %}
  <section class="data-strip" aria-labelledby="prices-h">
    <h2 class="eyebrow" id="prices-h">Day-ahead power price<span class="eyebrow-note">{{ ed.day|day_label }}, € per MWh, mean and range · last {{ ed.days }} days · <a href="{{ ed.url }}">Energinet</a></span></h2>
    <ul class="prices">
      {% for a in ed.areas %}
      <li><span class="zone">{{ a.label }}</span><span class="pv">{{ a.mean|eur }}</span><span class="range">{{ a.min|eur }}–{{ a.max|eur }}{% if a.partial %} <abbr title="Not every quarter-hour of the day is in yet">part</abbr>{% endif %}</span>{{ a.series|price_spark(a.label) }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
  {% if e.food_data %}
  {# EU farm-gate prices beside the food desk's news (pipeline/food_data.py): never labeled, never in the index. Ink only. #}
  {% set fd = e.food_data %}
  <section class="data-strip" aria-labelledby="farm-h">
    <h2 class="eyebrow" id="farm-h">EU farm prices<span class="eyebrow-note">{% if fd.week %}week of {{ fd.week|day_label }}, {% endif %}EU average, change over 4 weeks (fertiliser: a month) · <a href="{{ fd.url }}">European Commission</a></span></h2>
    <ul class="prices">
      {% for f in fd.figures %}
      <li><span class="zone">{{ f.label }}{% if f.monthly %} · {{ f.period|month_label }}{% endif %}</span><span class="pv">{{ f.value|eur if f.value >= 100 else f.value|eur2 }}</span><span class="range">{{ f.unit }}{% if f.change_pct is not none %} {{ f.change_pct|pct }}{% endif %}</span>{{ f.series|price_spark(f.label, f.unit_words, "price", "month" if f.monthly else "week", f.unit) }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
  {% if listen %}
  {# The edition read aloud (qa bulletin). The native player works without JS; app.js adds the speed buttons. #}
  <div class="listen" aria-labelledby="listen-h">
    <p class="eyebrow" id="listen-h">Listen<span class="eyebrow-note">{% if listen.minutes %}{{ listen.minutes }} min, {% endif %}read by a synthetic voice{% if listen.transcript %} · <a href="{{ listen.transcript }}">transcript</a>{% endif %}</span></p>
    <div class="listen-row">
      <audio controls preload="none" src="{{ listen.src }}"></audio>
      <div class="speed" role="group" aria-label="Playback speed" hidden>
        {% for r in ["1", "1.25", "1.5", "1.75", "2"] %}<button type="button" data-rate="{{ r }}" aria-pressed="{{ 'true' if r == '1' else 'false' }}">{{ r }}×</button>{% endfor %}
      </div>
    </div>
  </div>
  {% endif %}
  </div>
  </div>
  {% if e.llm.budget_reached %}
  <p class="notice">This month's budget for machine labeling is used up. Stories and links still update; labels and summaries are paused until next month.</p>
  {% endif %}

  {% if e.terms %}
  <div class="terms" aria-labelledby="terms-h">
    <h2 id="terms-h" class="eyebrow">Most mentioned <span class="eyebrow-note">by number of outlets, last {{ period.label }}</span></h2>
    <ul class="term-list">
      {% for t in e.terms %}
      <li><button type="button" class="term t{{ t.size }}" data-term="{{ t.key }}" aria-pressed="false" disabled
          title="{{ t.label }}: mentioned by {{ t.outlets }} outlets{% if t.stories %}; in {{ t.stories }} of the stories below{% endif %}">{{ t.label }}<span class="term-n">{{ t.outlets }}</span></button></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <nav class="filters" aria-label="Filter stories by track" hidden>
    <button type="button" data-track="" aria-pressed="true">All <span class="n">{{ e.stories|length }}</span></button>
    {% for t in ["technical", "political", "economic"] %}
    {% set n = e.stories|selectattr("track", "equalto", t)|list|length %}
    <button type="button" data-track="{{ t }}" aria-pressed="false"{% if not n %} disabled{% endif %}>{{ t|capitalize }} <span class="n">{{ n }}</span></button>
    {% endfor %}
    <span class="filter-state" aria-live="polite"></span>
  </nav>
  {% if places %}
  {# Where the coverage comes from: a region, then one of its countries. A story shows when at least one of its
     outlets is there. #}
  <nav class="filters places" aria-label="Filter stories by where their outlets are" hidden>
    <button type="button" data-codes="" aria-pressed="true">Anywhere <span class="n">{{ e.stories|length }}</span></button>
    {% for r in places %}
    <button type="button" data-region="{{ r.name }}" data-codes="{{ r.codes|join(' ') }}" aria-pressed="false"{% if not r.n %} disabled{% endif %}>{{ r.name }} <span class="n">{{ r.n }}</span></button>
    {% endfor %}
    {% for r in places if r.countries|length > 1 %}
    <span class="place-row" data-region="{{ r.name }}" hidden>
      {% for c in r.countries %}<button type="button" data-region="{{ r.name }}" data-codes="{{ c.code }}" data-name="{{ c.name }}" aria-pressed="false">{{ c.name }} <span class="n">{{ c.n }}</span></button>{% endfor %}
    </span>
    {% endfor %}
  </nav>
  {% endif %}
</header>

<main>
{% if not e.stories %}
<p class="notice">No stories here yet. {% if desk_label %}This desk is new: its outlets' articles are sorted onto it and labeled at each morning's edition, and stories appear as they come in.{% else %}They appear as articles come in.{% endif %}</p>
{% endif %}
<section class="stories" aria-label="Top stories">
{% for s in e.stories %}
<article class="card" id="{{ s.id }}" data-track="{{ s.track or 'none' }}" data-terms="{{ s.terms|join('|') }}" data-countries="{{ s|story_countries|join(' ') }}">
  {% if s.segments %}
  <p class="stripe" role="img" aria-label="{{ s.stripe_label }}" title="{{ s.stripe_label }}">{% for seg in s.segments %}<span class="seg st{{ seg.key }}" style="width:{{ seg.pct }}%"></span>{% endfor %}</p>
  {% else %}
  <p class="stripe stripe-none" aria-hidden="true"></p>
  {% endif %}
  <p class="kicker"><span class="rank">{{ "%02d"|format(s.rank) }}</span>{% if s.track %}<span class="track">{{ s.track }}</span>{% endif %}{% if s.source %}<a class="open-source" href="{{ s.source.url }}" rel="noopener" aria-label="Open the top source, {{ s.source.outlet }}{% if s.source.official %} (official){% endif %}"><span class="open-source-label" aria-hidden="true">Top source</span><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><g class="globe"><circle cx="8" cy="8" r="6.5"/><ellipse cx="8" cy="8" rx="2.8" ry="6.5"/><path d="M1.5 8h13M2.6 4.6h10.8M2.6 11.4h10.8"/></g></svg></a>{% endif %}</p>
  <h2>{{ s.headline }}</h2>

  {% if s.outlets %}
  <p class="meta"><span>{{ s.outlets }} outlet{{ "s" if s.outlets != 1 }}</span> <span class="sep">·</span> <span>{{ s.countries }} countr{{ "ies" if s.countries != 1 else "y" }}</span>{% if s.stance_summary %} <span class="sep">·</span> <span class="stance-summary">{{ s.stance_summary }}</span>{% endif %}</p>
  {% else %}
  <p class="meta">Builders only <span class="sep">·</span> no outlet coverage yet</p>
  {% endif %}

  {# How the outlets frame it: one line per framing, with how many outlets and where they are. Hovering, focusing
     or tapping the count shows those outlets' headlines (CSS only). Summaries from before story_summary_v4 keep
     their prose. #}
  {% set frames = s|frame_rows %}
  {% if frames %}
  <ul class="frames" aria-label="How the outlets frame it">
    {% for f in frames %}
    <li class="fr-row"><span class="fr-text">{{ f.frame }}</span>
      {%- if f.outlets %} <span class="fr-who" tabindex="0" aria-label="{{ f.outlets }} outlet{{ "s" if f.outlets != 1 }}{% if f.countries %} in {% for c in f.countries %}{{ country_names.get(c, c) }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}: show their headlines"><span class="fr-arrow" aria-hidden="true">←</span> {{ f.outlets }} outlet{{ "s" if f.outlets != 1 }}{% if f.countries %} <span class="sep">·</span> <span class="fr-cc">{{ f.countries[:6]|join(" ") }}{% if f.countries|length > 6 %} +{{ f.countries|length - 6 }}{% endif %}</span>{% endif %}</span>
      <span class="fr-tip">
        {%- for c in f["items"] %}
        <span class="fr-src"><span class="outlet"><span class="dot st{{ c.stance }}" aria-hidden="true"></span>{{ c.outlet }}{% if c.country %} <span class="country">{{ c.country }}</span>{% endif %}</span><a href="{{ c.url }}" rel="noopener">{{ c.title_en or c.title }}</a></span>
        {%- endfor %}
      </span>
      {%- endif %}</li>
    {% endfor %}
  </ul>
  {% elif s.summary and s.summary.coverage %}
  <p class="coverage">{{ s.summary.coverage }}</p>
  {% endif %}

  {% set b = s.builders %}
  {% set more = s.coverage or b.hn or b.repos or b.models or b.papers or b.official or b.x or b.reddit or b.posts %}
  {# The builders summary lives in the expanded panel; a card with nothing to expand keeps it. #}
  {% if s.builders_line and not more %}
  <p class="builders"><span class="label">Builders</span> {{ b|builders_html if b else s.builders_line }}</p>
  {% endif %}

  {% set counts = [s.stance.get("-2", 0), s.stance.get("-1", 0), s.stance.get("0", 0), s.stance.get("1", 0), s.stance.get("2", 0)] %}
  {% set total = counts|sum %}
  {% if more or total %}
  <div class="card-foot">
    {% if more %}
    <details>
      <summary aria-controls="{{ s.id }}-more">{% if s.coverage %}Expand Sources{% else %}Links{% endif %}</summary>
    </details>
    {% endif %}
    {% if total %}
    {# Stance of the coverage: one bar per step from strongly critical to enthusiastic, scaled to the largest,
       with a face for each step under it. Hover or focus shows the counts and the average. #}
    {% set top = counts|max %}
    {% set mean = (counts[1] * -1 + counts[0] * -2 + counts[3] + counts[4] * 2) / total %}
    <span class="stance-chart" tabindex="0" role="img" aria-label="{{ s.stance_label }}. Average {{ mean|signed }} on a scale from −2 to +2.">
      <svg viewBox="0 0 58 38" aria-hidden="true" focusable="false">
        {% for n in counts %}{% set h = (22 * n / top)|round(1) if n else 0 %}<rect class="sb{{ loop.index }}" x="{{ loop.index0 * 12 + 1 }}" y="{{ 23 - h }}" width="8" height="{{ h }}" rx="0.8"/>{% endfor %}
        <line class="sbase" x1="0" x2="58" y1="23.5" y2="23.5"/>
        {% for curve in [-2.2, -1.1, 0, 1.1, 2.2] %}{% set cx = loop.index0 * 12 + 5 %}<g class="sface"><circle cx="{{ cx }}" cy="31.5" r="4.6"/><circle class="eye" cx="{{ cx - 1.6 }}" cy="30.1" r="0.6"/><circle class="eye" cx="{{ cx + 1.6 }}" cy="30.1" r="0.6"/><path d="M{{ cx - 2.1 }} 33.2 Q{{ cx }} {{ 33.2 + curve }} {{ cx + 2.1 }} 33.2"/></g>{% endfor %}
      </svg>
      <span class="stance-tip" aria-hidden="true">
        {% set labeled = total + s.stance.get("unclear", 0) %}<span class="tip-head">Stance of {{ labeled }} article{{ "s" if labeled != 1 }}</span>
        {% for k in ["-2", "-1", "0", "1", "2"] %}<span class="tip-row"><i class="tip-dot st{{ k }}"></i>{{ stance_names[k] }}<b>{{ s.stance.get(k, 0) }}</b></span>{% endfor %}
        {% if s.stance.get("unclear") %}<span class="tip-row tip-muted"><i class="tip-dot stunclear"></i>Unclear<b>{{ s.stance.get("unclear") }}</b></span>{% endif %}
        <span class="tip-avg">Average<b>{{ mean|signed }}</b></span>
      </span>
    </span>
    {% endif %}
  </div>
  {% endif %}
  {% if s.narrative and s.narrative.timeline %}
  {# The narrative's seal on the card's top edge: this story has been covered for days; the seal links to how it evolved. #}
  <a class="seal-link" href="{{ base }}narratives/{{ s.narrative.id }}/" aria-label="Part of a narrative: {{ s.narrative.days }} days of coverage. See how it evolved" title="A narrative: {{ s.narrative.days }} days of coverage, {{ s.narrative.first|date_range(s.narrative.last) }}">{{ s.narrative|seal }}</a>
  {% endif %}
</article>
{# Opened from the card's summary, the headlines take the whole row under the card's row
   (the grid packs densely, so the cards after it still fill the card's own row). #}
{% if more %}
<div class="panel" id="{{ s.id }}-more" role="region" aria-label="{% if s.coverage %}Headlines by stance{% else %}Links{% endif %}: {{ s.headline }}">
  <p class="panel-head"><span class="rank">{{ "%02d"|format(s.rank) }}</span> {{ s.headline }}</p>
  {% if s.coverage %}
  {# The corner icon swaps the grouped view for a plain list: every source URL and how it was labeled. #}
  <details class="raw-toggle">
    <summary aria-label="Show every source URL with its labels" title="Every source URL with its labels"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5.5 4h8M5.5 8h8M5.5 12h8"/><circle cx="2.6" cy="4" r="0.9"/><circle cx="2.6" cy="8" r="0.9"/><circle cx="2.6" cy="12" r="0.9"/></svg><span class="raw-toggle-label">All URLs</span></summary>
  </details>
  {% endif %}
  {% if s.builders_line %}<p class="builders"><span class="label">Builders</span> {{ b|builders_html }}</p>{% endif %}
  {% if s.summary and s.summary.builders %}<p class="builders-long">{{ s.summary.builders|link_platforms(b) }}</p>{% endif %}
  {% if s.coverage %}
  <div class="raw-list">
    <p class="raw-head">Every source, as labeled <span class="count">{{ s.coverage|sum(attribute="items", start=[])|length }}</span></p>
    <ol>
      {% for g in s.coverage %}{% for c in g["items"] %}
      <li><span class="raw-meta"><span class="dot st{{ g.stance }}" aria-hidden="true"></span>{{ stance_names[g.stance] }}{% if c.track and g.stance not in ["unclear", "unlabeled"] %}<span class="sep">·</span>{{ c.track }}{% endif %}{% if c.frame and g.stance not in ["unclear", "unlabeled"] %}<span class="sep">·</span>{{ c.frame }}{% endif %}<span class="sep">·</span>{{ c.outlet }}{% if c.country %} ({{ c.country }}){% endif %}</span>
        <a class="raw-url" href="{{ c.url }}" rel="noopener">{{ c.url }}</a></li>
      {% endfor %}{% endfor %}
    </ol>
  </div>
  {% endif %}
  <div class="panel-groups">
    {% for g in s.coverage %}
    <div class="group">
      <h3><span class="dot st{{ g.stance }}" aria-hidden="true"></span>{{ stance_names[g.stance] }} <span class="count">{{ g["items"]|length }}</span></h3>
      {% if g.countries %}<p class="group-countries" aria-label="Countries: {% for c, n in g.countries %}{{ country_names.get(c, c) }} {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}">{% for c, n in g.countries %}<span title="{{ country_names.get(c, c) }}: {{ n }} outlet{{ "s" if n != 1 }}">{{ c }}{% if n > 1 %} <b>{{ n }}</b>{% endif %}</span>{% endfor %}</p>{% endif %}
      <ul>
        {% for c in g["items"] %}
        <li>
          <span class="outlet">{{ c.outlet }}{% if c.country %} <span class="country">{{ c.country }}</span>{% endif %}{% if kind_names[c.kind] %} <span class="country">{{ kind_names[c.kind] }}</span>{% endif %}</span>
          <a href="{{ c.url }}" rel="noopener"{% if c.title_en and c.title_en != c.title %} title="{{ c.title }}" lang="{{ c.lang }}"{% endif %}>{{ c.title_en or c.title }}</a>
          {% if c.title_en and c.title_en != c.title %}<span class="lang">translated from {{ c.lang }}</span>{% endif %}
          {% if c.llm_opt_out %}
          <span class="why">Not labeled: the publisher opts out of AI processing.</span>
          {% elif c.evidence %}
          <span class="why" title="{{ c.rationale or '' }}">{% if c.frame and g.stance not in ["unclear", "unlabeled"] %}<span class="frame">{{ c.frame }}</span> {% endif %}<q>{{ c.evidence[0] }}</q></span>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
    {% if b.hn or b.repos or b.models or b.papers or b.official or b.x or b.reddit or b.posts %}
    <div class="group">
      <h3>Builder links</h3>
      <ul>
        {% for o in b.official %}<li><span class="outlet">{{ o.source }}</span> <a href="{{ o.url }}" rel="noopener">{{ o.title }}</a></li>{% endfor %}
        {% for h in b.hn[:3] %}<li><span class="outlet">Hacker News <span class="num">{{ h.points|thousands }} points · {{ h.comments|thousands }} comments</span></span> <a href="{{ h.url }}" rel="noopener">{{ h.title }}</a></li>{% endfor %}
        {% for r in b.repos[:5] %}<li><span class="outlet">GitHub <span class="num">{{ r.stars|thousands }} stars</span></span> <a href="{{ r.url }}" rel="noopener">{{ r.title }}</a></li>{% endfor %}
        {% for m in b.models[:5] %}<li><span class="outlet">{{ m.source }}</span> <a href="{{ m.url }}" rel="noopener">{{ m.title }}</a></li>{% endfor %}
        {% for p in b.papers[:3] %}<li><span class="outlet">Paper</span> <a href="{{ p.url }}" rel="noopener">{{ p.title }}</a></li>{% endfor %}
        {% for p in (b.posts or [])[:5] %}<li><span class="outlet">{{ p.source }}</span> <a href="{{ p.url }}" rel="noopener">{{ p.title|truncate(140) }}</a></li>{% endfor %}
        {% for r in (b.reddit or [])[:4] %}<li><span class="outlet">r/{{ r.sub }}{% if r.activity %} <span class="num">{{ r.activity|thousands }} activity</span>{% endif %} <span class="country">via {{ b.via|join(", ") }}</span></span> <a href="{{ r.url }}" rel="noopener">{{ r.title or "Reddit thread" }}</a></li>{% endfor %}
        {% if b.x %}<li><span class="outlet">X <span class="num">{{ b.x|length }} post{{ "s" if b.x|length != 1 }}</span> <span class="country">via {{ b.via|join(", ") }}</span></span> {% for p in b.x[:8] %}<a href="{{ p.url }}" rel="noopener">@{{ p.account }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% if b.x|length > 8 %} and {{ b.x|length - 8 }} more{% endif %}</li>{% endif %}
      </ul>
    </div>
    {% endif %}
  </div>
</div>
{% endif %}
{% endfor %}
<p class="empty" hidden>No stories match this filter. <button type="button" class="reset">Show all</button></p>
</section>

{% set nv = e.narratives or {} %}
{% if nv.get("items") %}
<section class="narratives" aria-labelledby="narr-h">
  <h2 id="narr-h">Narratives</h2>
  <p class="section-note">Stories the press has covered {{ nv.min_days }} days or more in a row, and how their stance moved.</p>
  <ol class="narr-list">{% for n in nv["items"] %}{{ nar.row(n, base) }}{% endfor %}</ol>
  <p class="num narr-more"><a href="{{ base }}narratives/">All narratives{% if nv.total > nv["items"]|length %}, {{ nv.total }} in all{% endif %}</a></p>
</section>
{% endif %}

{% set gp = e.gap or {} %}
{% if gp.builders_not_press or gp.press_not_builders %}
<section class="gap" aria-labelledby="gap-h">
  <h2 id="gap-h">The gap</h2>
  <p class="section-note">Where builders and the press are looking at different things, last {{ period.label }}.</p>
  <div class="gap-cols">
    <div>
      <h3 class="eyebrow">Builders are talking, press isn't</h3>
      {% if gp.builders_not_press %}
      <ol>{% for g in gp.builders_not_press %}
        <li><p class="g-head">{% if g.link %}<a href="{{ g.link }}" rel="noopener">{{ g.headline }}</a>{% else %}{{ g.headline }}{% endif %}</p>
          <p class="num">{{ g.builders_line }}{% if g.outlets %} · {{ g.outlets }} outlet{% else %} · no outlet coverage{% endif %}</p></li>
      {% endfor %}</ol>
      {% else %}<p class="muted">Nothing big that the press is missing.</p>{% endif %}
    </div>
    <div>
      <h3 class="eyebrow">Press is talking, builders aren't</h3>
      {% if gp.press_not_builders %}
      <ol>{% for g in gp.press_not_builders %}
        <li><p class="g-head"><a href="#{{ g.id }}">{{ g.headline }}</a></p>
          <p class="num">{{ g.outlets }} outlets · {{ g.countries }} countries{% if g.stance_summary %} · {{ g.stance_summary }}{% endif %} · no builder discussion</p></li>
      {% endfor %}</ol>
      {% else %}<p class="muted">No big press story without builder interest.</p>{% endif %}
    </div>
  </div>
</section>
{% endif %}

{% if e.rising_groups %}
<section class="rising" aria-labelledby="rising-h">
  <div class="rising-head">
    <h2 id="rising-h">Rising</h2>
    <p class="section-note">Fastest-climbing projects among builders, last {{ period.label }}, by what they are.</p>
  </div>
  <nav class="filters rising-filters" aria-label="Filter rising projects by category" hidden>
    <button type="button" data-category="" aria-pressed="true">All <span class="n">{{ e.rising|length }}</span></button>
    {% for g in e.rising_groups %}
    <button type="button" data-category="{{ g.slug }}" aria-pressed="false">{{ g.label }} <span class="n">{{ g["items"]|length }}</span></button>
    {% endfor %}
  </nav>
  <div class="rising-groups">
    {% for g in e.rising_groups %}
    <div class="rgroup" data-category="{{ g.slug }}">
      <h3 class="eyebrow">{{ g.label }} <span class="count">{{ g["items"]|length }}</span></h3>
      <ol>
        {% for r in g["items"] %}
        <li>
          <p class="r-head"><a href="{{ r.url }}" rel="noopener">{{ r.title }}</a></p>
          {% if r.what %}<p class="what">{{ r.what }}</p>{% endif %}
          {% if r.why %}<p class="why-it">{{ r.why }}</p>{% endif %}
          <p class="num">{{ r.signal }}</p>
          {% if r.talk %}<p class="num talk">Discussed{% if r.talk.reddit %} on {% for t in r.talk.reddit[:2] %}<a href="{{ t.url }}" rel="noopener">r/{{ t.sub }}</a>{% if t.activity %} ({{ t.activity|thousands }}){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}{% if r.talk.x %}{% if r.talk.reddit %} and{% endif %} on X by {% for p in r.talk.x[:3] %}<a href="{{ p.url }}" rel="noopener">@{{ p.account }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% if r.talk.x|length > 3 %} +{{ r.talk.x|length - 3 }}{% endif %}{% endif %}, via {{ r.talk.via|join(", ") }}</p>{% endif %}
        </li>
        {% endfor %}
      </ol>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}
</main>

<footer class="colophon">
  <p class="legend" aria-hidden="true">
    {% for k in ["-2", "-1", "0", "1", "2", "unclear"] %}<span><span class="dot st{{ k }}"></span>{{ stance_names[k] }}</span>{% endfor %}
  </p>
  <p>Stories are ranked by how many outlets, countries and builder communities are picking them up. Each headline's framing and stance are labeled by a language model from the headline and summary alone; the phrase in quotes is the evidence it pointed to, so you can judge for yourself. "Unclear" means the model wasn't confident.</p>
  <p>No ads, no tracking, no images. Headlines link to the original publishers. <a href="{{ root }}about/">How this site works</a>.</p>
</footer>

</div>
<script src="{{ root }}static/app.js" defer></script>
</body>
</html>
