# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Optional. Raises the GitHub search limit from 10 to 30 requests/minute. In Actions this is the built-in token.
GITHUB_TOKEN=
# Labels, summaries and the weather line (Claude Haiku / Sonnet). Without it the pipeline runs keyword-only.
ANTHROPIC_API_KEY=
