		<title>NYC Kalshi users lost over $52M in 2026 &#8212; with young adults accounting for large portion of losses: City Council</title>
		<comments>https://nypost.com/2026/11/24/business/nyc-kalshi-users-lost-over-52m-in-2026-city-council/#respond</comments>
		<pubDate>Tue, 24 Nov 2026 16:18:17 -0500</pubDate>
		<dcterms:modified>2026-11-24T16:18:28-05:00</dcterms:modified>
						<link>https://nypost.com/2026/11/24/business/nyc-kalshi-users-lost-over-52m-in-2026-city-council/</link>
			<dc:creator>Ariel Zilber</dc:creator>
		
		<guid isPermaLink="false">https://nypost.com/?post_type=article&#038;p=42089505</guid>
												<description><![CDATA[Individual Kalshi users with New York City addresses collectively lost $52.5 million between Jan. 1 and Nov. 1, according to New York City Council.]]></description>
			
								<enclosure url="https://nypost.com/wp-content%2Fuploads%2Fsites%2F2%2F2026%2F11%2F149919284.jpg?quality%3D90%26strip%3Dall"
						type="image/jpeg"
						length="969777"
					/>
							<slash:comments>0</slash:comments>
			<post-id xmlns="com-wordpress:feed-additions:1">42089505</post-id>
		<media:thumbnail url="https://nypost.com/wp-content%2Fuploads%2Fsites%2F2%2F2026%2F11%2F149919284.jpg?quality%3D90%26" />
		<media:content url="https://nypost.com/wp-content%2Fuploads%2Fsites%2F2%2F2026%2F11%2F149919284.jpg?quality%3D90%26strip%3Dall" medium="image">
			<media:title type="html">149919284</media:title>
		</media:content>

		<media:content url="https://nypost.com/wp-content%2Fuploads%2Fsites%2F2%2F2026%2F11%2F2026-agreement-lyft-cap-cost-149848975.jpg?w%3D1024" medium="image">
			<media:title type="html">City Council Speaker Julie Menin accused prediction market operators of using deceptive marketing tactics to attract young customers.</media:title>
		</media:content>

		<media:content url="https://nypost.com/wp-content%2Fuploads%2Fsites%2F2%2F2026%2F11%2Fgeneral-view-kalshi-logo-displayed-125429741_104bc1.jpg?w%3D1024" medium="image">
			<media:title type="html">Individual Kalshi users with New York City addresses racked up $52.5 million in net trading losses between Jan. 1 and Nov. 1, according to the City Council.</media:title>
		</media:content>

		<media:content url="https://nypost.com/wp-content%2Fuploads%2Fsites%2F2%2F2026%2F11%2Fgeneral-view-advertisement-kalshi-sports-130833866_fcdfb6.jpg?w%3D1024" medium="image">
			<media:title type="html">Kalshi introduced a default monthly deposit limit of $2,500 for customers between the ages of 18 and 20 in October.</media:title>
		</media:content>

		<media:content url="https://nypost.com/wp-content%2Fuploads%2Fsites%2F2%2F2026%2F11%2F2026-flatbush-neighborhood-brooklyn-borough-148670041.jpg?w%3D1024" medium="image">
			<media:title type="html">New York Attorney General Letitia James has accused Kalshi of operating an illegal sports gambling business without a state license.</media:title>
		</media:content>
	</item>
