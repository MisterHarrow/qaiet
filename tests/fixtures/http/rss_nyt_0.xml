      <category domain="http://www.nytimes.com/namespaces/keywords/des">Appointments and Executive Changes</category>
      <category domain="http://www.nytimes.com/namespaces/keywords/des">Artificial Intelligence</category>
      <category domain="http://www.nytimes.com/namespaces/keywords/nyt_per">Jones, Harvey C</category>
      <category domain="http://www.nytimes.com/namespaces/keywords/nyt_per">Trump, Donald J</category>
      <category domain="http://www.nytimes.com/namespaces/keywords/des">Computer Chips</category>
      <category domain="http://www.nytimes.com/namespaces/keywords/des">Industrial Espionage</category>
      <media:content height="1800" medium="image" url="https://static01.nyt.com/images/2026/11/23/multimedia/23biz-nvidia-board-1-hjlv/23biz-nvidia-board-1-hjlv-mediumSquareAt3X.jpg" width="1800"></media:content>
      <media:credit>Mike Kai Chen for The New York Times</media:credit>
      <media:description>On Monday, Nvidia said that the board had “voted unanimously” to bring Jensen Huang back as the company’s leader.</media:description>
