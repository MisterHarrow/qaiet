    "record": {
     "$type": "app.bsky.feed.post",
     "createdAt": "2026-11-22T17:06:12.691Z",
     "embed": {
      "$type": "app.bsky.embed.external",
      "external": {
       "description": "It's the story of the lawyers who fought for your privacy, the government that lied about spying on you, and the whistleblower who blew it all wide open.",
       "thumb": {
        "$type": "blob",
        "ref": {
         "$link": "bafkreid3ghtfve4w5buywieu24uad3fvhtcg6pl6yxy3x4sdmhp4otm6ji"
        },
        "mimeType": "image/jpeg",
        "size": 984904
       },
       "title": "Privacy's Defenders Podcast: Snowden Exposes NSA’s Lies",
       "uri": "https://www.eff.org/deeplinks/2026/11/privacys-defenders-podcast-snowden-exposes-nsas-lies"
      }
     },
     "langs": [
      "en"
     ],
     "text": "For EFF and its clients, Edward Snowden’s documents were proof of the secret surveillance the government had spent years refusing to confirm: “We were struggling along in the mud, and we felt like somebody gave us wings.”   \nHear E4 of our Privacy’s Defenders podcast: “Snowden Exposes NSA’s Lies.”"
    },
